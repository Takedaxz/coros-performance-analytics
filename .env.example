# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=coros
POSTGRES_PASSWORD=coros_dev
POSTGRES_DB=coros_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://coros:coros_dev@localhost:5432/coros_analytics

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
RAW_FILE_STORE_PATH=./data/raw_files

# ─── Owner (single-user installation) ────────────────────────────────────────
# Keep this value when upgrading so existing data remains associated with the owner.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
OWNER_EMAIL=you@example.com
OWNER_TIMEZONE=UTC           # e.g. Asia/Bangkok, America/New_York
OWNER_UNITS=metric           # metric | imperial

# ─── COROS Sync ───────────────────────────────────────────────────────────────
# Note: COROS account credentials are set directly in the Web UI (Settings page)
# and stored encrypted in the database. No credentials needed in .env!
SYNC_INTERVAL_MINUTES=15

# ─── Gemini AI (optional) ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false

# ─── OpenAI-compatible AI (optional) ─────────────────────────────────────────
# Set to true and fill in the fields below to use any OpenAI-compatible server
# (vLLM, LM Studio, Ollama, etc.).  Takes priority over Gemini when enabled.
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_API_KEY=your_api_key
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=llama3

# ─── Brave Search (optional; live coaching research) ─────────────────────────
# Keep this server-side only. Never add it to frontend environment variables.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
