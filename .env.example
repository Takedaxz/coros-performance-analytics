# --- Database ---
POSTGRES_USER=coros
POSTGRES_PASSWORD=coros_dev
POSTGRES_DB=coros_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
ALLOWED_USER_EMAIL=you@example.com

# --- COROS API ---
COROS_EMAIL=coros@email.com
COROS_PASSWORD=coros1234

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_ENABLED=false

# --- OpenAI-compatible AI (optional, takes priority over Gemini when enabled) ---
# Set OPENAI_COMPAT_ENABLED=true to route all AI calls through an OpenAI-compatible endpoint.
# Any server supporting the OpenAI Chat Completions API works: vLLM, LM Studio, Ollama, KKU OKMD, etc.
OPENAI_COMPAT_ENABLED=false
OPENAI_COMPAT_API_KEY=your_openai_compat_api_key
OPENAI_COMPAT_BASE_URL=https://gen.ai.kku.ac.th/okmd/api/v1
OPENAI_COMPAT_MODEL=claude-sonnet-4.6
